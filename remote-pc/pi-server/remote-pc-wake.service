[Unit]
Description=Remote PC wake/control gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/remote-pc/pi-server
ExecStart=/usr/bin/python3 /home/pi/remote-pc/pi-server/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
